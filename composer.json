{
    "name": "bensomething/craft-cast",
    "description": "Colour modes for the control panel.",
    "type": "craft-plugin",
    "license": "MIT",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "plugin",
        "dark mode",
        "theme",
        "accessibility",
        "contrast",
        "control panel"
    ],
    "support": {
        "issues": "https://github.com/bensomething/craft-cast/issues",
        "source": "https://github.com/bensomething/craft-cast"
    },
    "require": {
        "php": "^8.5",
        "craftcms/cms": "^6.0.0-beta.1"
    },
    "require-dev": {
        "inertiajs/inertia-laravel": "^3.1",
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "bensomething\\cast\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "bensomething\\cast\\tests\\": "tests/"
        }
    },
    "extra": {
        "handle": "cast",
        "name": "Cast",
        "developer": "Ben Smith",
        "developerUrl": "https://bensomething.com",
        "documentationUrl": "https://github.com/bensomething/craft-cast",
        "changelogUrl": "https://raw.githubusercontent.com/bensomething/craft-cast/2.x/CHANGELOG.md",
        "class": "bensomething\\cast\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true
        }
    },
    "scripts": {
        "check-cs": "pint --test",
        "fix-cs": "pint",
        "phpstan": "phpstan --memory-limit=1G",
        "test": "phpunit --colors=always"
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
