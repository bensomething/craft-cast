{# Rendered through the `cp.users.edit.prefs` hook, which Craft 6 places directly under
   its own Theme field. Craft's field picks light or dark; these pick what each looks like.
   The contrast switch is moved to Accessibility by the script below.

   The page's own form never posts these, so each control saves itself on change. #}
{# @var lightOptions array #}
{# @var darkOptions array #}
{# @var lightValue string #}
{# @var darkValue string #}
{# @var lightDefault string #}
{# @var darkDefault string #}
{# @var highContrast bool #}
{# @var saveUrl string #}
{# @var csrfToken string #}
{# @var craftTheme string Craft's saved Theme: light, dark or system. #}
{# @var buttonOptions array{colors: string[], labels: array} #}
{# @var buttonValue string The colour shown as chosen, Craft's own as `blue`. #}
{# @var buttonDefault string The site's default colour, or empty for Craft's. #}
{# @var buttonHandles array Picker values that aren't colour names, to the names stored. #}

{# A group of its own, after Craft's. The section spaces groups 12px apart and a group's
   fields 24px, so the difference goes on top to sit these at the field spacing. #}
<craft-field-group id="cast-prefs" style="margin-block-start: calc(var(--c-spacing) * 3)">
    {% for field in [
        { scheme: 'light', label: 'Light Appearance' | t('cast'), options: lightOptions, value: lightValue },
        { scheme: 'dark', label: 'Dark Appearance' | t('cast'), options: darkOptions, value: darkValue },
    ] %}
        {# Only worth asking where there's a theme to choose besides Craft's own. #}
        {% if field.options | filter(o => o.value not in ['inherit', '']) | length %}
            {# Only the modes Craft's Theme can show: one for Light or Dark, both for
               System. Hidden inline rather than with `hidden`, which the component's own
               `:host` display would override. #}
            {% tag 'craft-select' with {
                'data-cast-field': field.scheme,
                style: craftTheme not in [field.scheme, 'system'] ? 'display: none' : false,
            } %}
                <label slot="label" for="cast-{{ field.scheme }}">{{ field.label }}</label>
                <select slot="input" id="cast-{{ field.scheme }}" data-cast-scheme="{{ field.scheme }}">
                    {% for option in field.options %}
                        <option value="{{ option.value }}" {{ option.value == field.value ? 'selected' }}>{{ option.label }}</option>
                    {% endfor %}
                </select>
            {% endtag %}
        {% endif %}
    {% endfor %}

    {# Always shown: unlike the appearances, it applies in either mode. #}
    <craft-select-color
        data-cast-field="button"
        id="cast-button"
        label="{{ 'Button Colour' | t('cast') }}"
        colors="{{ buttonOptions.colors | json_encode }}"
        labels="{{ buttonOptions.labels | json_encode }}"
        value="{{ buttonValue }}"
    ></craft-select-color>

    <craft-checkbox-group id="cast-contrast-field">
        <label slot="label">{{ 'Contrast' | t('cast') }}</label>
        <craft-checkbox>
            <input slot="input" type="checkbox" id="cast-contrast" {{ highContrast ? 'checked' }}>
            <label slot="label" for="cast-contrast">{{ 'Increase contrast' | t('cast') }}</label>
        </craft-checkbox>
    </craft-checkbox-group>
</craft-field-group>

{# The behaviour lives in `_prefs.js`, so it can be tested outside Craft. #}
{% js %}
    {{ source('cast/_prefs.js') | raw }}

    CastPreferences({{ {
        url: saveUrl,
        token: csrfToken,
        defaults: { light: lightDefault, dark: darkDefault },
        craftTheme: craftTheme,
        buttonDefault: buttonDefault,
        buttonHandles: buttonHandles,
    } | json_encode | raw }});
{% endjs %}
