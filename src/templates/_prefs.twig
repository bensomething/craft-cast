{# Rendered through the `cp.users.edit.prefs` hook, which Craft 6 places directly under
   its own Theme field. Craft's field picks light or dark; these pick what each looks like.
   The contrast switch is moved to Accessibility by the script below.

   The page's own form never posts these, so each control saves itself on change. #}
{# @var lightOptions array #}
{# @var darkOptions array #}
{# @var lightValue string #}
{# @var darkValue string #}
{# @var lightDefault string #}
{# @var darkDefault string #}
{# @var highContrast bool #}
{# @var saveUrl string #}
{# @var csrfToken string #}
{# @var craftTheme string Craft's saved Theme: light, dark or system. #}

{# A group of its own, after Craft's. The section spaces groups 12px apart and a group's
   fields 24px, so the difference goes on top to sit these at the field spacing. #}
<craft-field-group id="cast-prefs" style="margin-block-start: calc(var(--c-spacing) * 3)">
    {% for field in [
        { scheme: 'light', label: 'Light Appearance' | t('cast'), help: 'Used when the control panel theme is light.' | t('cast'), options: lightOptions, value: lightValue },
        { scheme: 'dark', label: 'Dark Appearance' | t('cast'), help: 'Used when the control panel theme is dark.' | t('cast'), options: darkOptions, value: darkValue },
    ] %}
        {# Only worth asking where there's more than Craft's own to choose from. #}
        {% if field.options | length > 2 %}
            {# Only the modes Craft's Theme can show: one for Light or Dark, both for
               System. Hidden inline rather than with `hidden`, which the component's own
               `:host` display would override. #}
            {% tag 'craft-select' with {
                'data-cast-field': field.scheme,
                style: craftTheme not in [field.scheme, 'system'] ? 'display: none' : false,
            } %}
                <label slot="label" for="cast-{{ field.scheme }}">{{ field.label }}</label>
                <span slot="help-text">{{ field.help }}</span>
                <select slot="input" id="cast-{{ field.scheme }}" data-cast-scheme="{{ field.scheme }}">
                    {% for option in field.options %}
                        <option value="{{ option.value }}" {{ option.value == field.value ? 'selected' }}>{{ option.label }}</option>
                    {% endfor %}
                </select>
            {% endtag %}
        {% endif %}
    {% endfor %}

    <craft-checkbox-group id="cast-contrast-field">
        <label slot="label">{{ 'Contrast' | t('cast') }}</label>
        <craft-checkbox>
            <input slot="input" type="checkbox" id="cast-contrast" {{ highContrast ? 'checked' }}>
            <label slot="label" for="cast-contrast">{{ 'Increase contrast' | t('cast') }}</label>
        </craft-checkbox>
    </craft-checkbox-group>
</craft-field-group>

{% js %}
    (function() {
        // Craft re-renders this fragment as the page updates, and runs this again each
        // time, so it has to be safe to repeat. Bind to the newest copy, once.
        var roots = document.querySelectorAll('#cast-prefs');
        var root = roots[roots.length - 1];

        if (!root || root.hasAttribute('data-cast-ready')) {
            return;
        }

        root.setAttribute('data-cast-ready', '');

        var config = {{ {
            url: saveUrl,
            token: csrfToken,
            defaults: { light: lightDefault, dark: darkDefault },
        } | json_encode | raw }};

        var dataset = document.documentElement.dataset;

        function save(body, what) {
            fetch(config.url, {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': config.token,
                },
                body: JSON.stringify(body),
            }).then(function(response) {
                if (!response.ok) {
                    throw new Error(response.statusText);
                }
            }).catch(function() {
                console.error('Cast couldn’t save the ' + what + '.');
            });
        }

        // Every theme's stylesheet is already on the page, so each change repaints at once.
        var keys = { light: 'castLight', dark: 'castDark' };

        // Follow Craft's Theme field as it changes, before it's saved. Delegated from the
        // document, as Vue owns those radios and may replace them. One listener for the
        // page, swapped for this render's, so re-renders don't stack them.
        if (window.CastThemeListener) {
            document.removeEventListener('change', window.CastThemeListener);
        }

        window.CastThemeListener = function(event) {
            var input = event.target;

            if (!input || input.name !== 'theme' || input.type !== 'radio' || !input.checked) {
                return;
            }

            root.querySelectorAll('[data-cast-field]').forEach(function(field) {
                var scheme = field.getAttribute('data-cast-field');
                var shown = input.value === 'system' || input.value === scheme;

                field.style.display = shown ? '' : 'none';
            });
        };

        document.addEventListener('change', window.CastThemeListener);

        root.querySelectorAll('select[data-cast-scheme]').forEach(function(select) {
            select.addEventListener('change', function() {
                var scheme = select.getAttribute('data-cast-scheme');
                var handle = select.value === 'inherit' ? config.defaults[scheme] : select.value;

                if (handle) {
                    dataset[keys[scheme]] = handle;
                } else {
                    delete dataset[keys[scheme]];
                }

                var body = {};
                body[scheme] = select.value;
                save(body, scheme + ' appearance');
            });
        });

        var contrastField = root.querySelector('#cast-contrast-field');
        var contrast = root.querySelector('#cast-contrast');

        contrast.addEventListener('change', function() {
            if (contrast.checked) {
                dataset.castContrast = 'more';
            } else {
                delete dataset.castContrast;
            }

            save({ highContrast: contrast.checked }, 'contrast setting');
        });

        // Craft gives plugins no hook on the Accessibility tab, so the switch moves there,
        // straight after Display Settings. It's placed beside Craft's own fields rather
        // than inside one, which Vue re-renders. If Craft's markup changes, it stays put
        // under Appearance, costing the position and not the setting.
        //
        // Once moved, the switch is outside the fragment, so Craft's cleanup of an old
        // render never reaches it. Whatever an earlier render moved goes first.
        var display = document.querySelector('#preferences-accessibility craft-field-group > craft-checkbox-select');

        if (display) {
            document.querySelectorAll('[data-cast-moved]').forEach(function(old) {
                old.remove();
            });

            contrastField.setAttribute('data-cast-moved', '');
            display.parentNode.insertBefore(contrastField, display.nextSibling);
        }
    })();
{% endjs %}
