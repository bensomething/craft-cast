{# The theme control injected into Craft's account menu. That menu is hardcoded in
   `_layouts/cp.twig` with no hook, so this is placed by JS. See Plugin::accountMenuJs().

   A select rather than menu items, so the menu stays one line however many themes are
   registered. Craft's disclosure menus have no submenu support. #}
{# @var options array #}
{# @var current string #}

<hr>
{# No horizontal padding of its own. `.menu` already insets content by 14px and its items
   bleed back out to land on that line, so adding more here double-indents the group. #}
<div class="cast-theme-field" style="padding-block: 0 10px;">
    <div class="smalltext light" style="margin-top: 10px;margin-bottom: 4px;">
        {{ 'Colour mode' | t('cast') }}
    </div>
    <div class="select fullwidth">
        <select id="cast-theme-select" aria-label="{{ 'Colour mode' | t('cast') }}">
            {% for option in options %}
                <option
                    value="{{ option.value }}"
                    data-cast-applies="{{ option.applies }}"
                    {{ option.value == current ? 'selected' }}
                >{{ option.label }}</option>
            {% endfor %}
        </select>
    </div>
</div>
